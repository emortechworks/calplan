{% extends 'base.html.twig' %}

{% block title %}Iniciar sesión · Calendario Planeación{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body">
                <h1 class="h3 mb-4">Iniciar sesión</h1>

                {% if error %}
                    <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}

                {% if app.user %}
                    <div class="alert alert-info">Sesión iniciada como <strong>{{ app.user.userIdentifier }}</strong> — <a href="{{ logout_path() }}">cerrar sesión</a></div>
                {% endif %}

                <form method="post">
                    <div class="mb-1">
                        <label for="username" class="form-label mb-1">Correo</label>
                        <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control mb-1" autocomplete="email" required autofocus>
                    </div>
                    <div class="mb-1">
                        <label for="password" class="form-label mb-1">Contraseña</label>
                        <input type="password" name="_password" id="password" class="form-control mb-1" autocomplete="current-password" required>
                    </div>
                    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                    <button class="btn btn-dark btn-lg w-100 m-2 p-2" type="submit">Entrar</button>
                </form>
                <p class="text-center text-body-secondary mt-3 mb-0">¿Sin cuenta? <a href="{{ path('app_register') }}">Regístrate</a></p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
