{% extends 'base.html.twig' %}

{% block title %}Mis sucursales · Calendario Planeación{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0 d-flex align-items-center gap-2">
    {{ ux_icon('bi:shop') }}
    <span>Mis sucursales</span>
  </h1>
  <a class="btn btn-dark m-2 p-2 d-inline-flex align-items-center gap-2" href="{{ path('app_sucursal_nueva') }}">
    {{ ux_icon('bi:plus-lg') }}
    <span>Nueva sucursal</span>
  </a>
</div>

{% for sucursal in sucursales %}
  <div class="card mb-2 {{ not sucursal.activa ? 'border-secondary opacity-75' }}">
    <div class="card-body d-flex justify-content-between align-items-center">
      <div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
          {{ ux_icon('bi:shop', { class: 'text-body-secondary' }) }}
          <span class="fw-bold">{{ sucursal.nombre }}</span>
          {% if sucursal.codigo %}<span class="badge text-bg-secondary">{{ sucursal.codigo }}</span>{% endif %}
          {% if not sucursal.activa %}<span class="badge text-bg-warning">desactivada</span>{% endif %}
        </div>
        {% if sucursal.roles|length > 0 %}
          <div class="d-flex flex-wrap gap-1 mt-2">
            {% for rol in sucursal.roles %}
              <span class="badge text-bg-light border text-dark d-inline-flex align-items-center gap-1">
                {{ ux_icon('bi:person-badge') }}
                <span>{{ rol.nombre }}</span>
              </span>
            {% endfor %}
          </div>
        {% endif %}
      </div>
      <div class="btn-group btn-group-sm">
        <a class="btn btn-outline-secondary m-2 p-2 d-inline-flex align-items-center gap-1" href="{{ path('app_sucursal_editar', { id: sucursal.id }) }}">
          {{ ux_icon('bi:pencil') }}
          <span>Editar</span>
        </a>
        <form method="post" action="{{ path('app_sucursal_alternar', { id: sucursal.id }) }}" class="m-0">
          <input type="hidden" name="_token" value="{{ csrf_token('alternar_sucursal' ~ sucursal.id) }}">
          <button class="btn btn-outline-secondary m-2 p-2 d-inline-flex align-items-center gap-1" type="submit">
            {% if sucursal.activa %}
              {{ ux_icon('bi:slash-circle') }}
              <span>Desactivar</span>
            {% else %}
              {{ ux_icon('bi:check-circle') }}
              <span>Reactivar</span>
            {% endif %}
          </button>
        </form>
      </div>
    </div>
  </div>
{% else %}
  <p class="text-body-secondary">Aún no tienes sucursales. <a href="{{ path('app_sucursal_nueva') }}">Crea la primera</a>.</p>
{% endfor %}
{% endblock %}
