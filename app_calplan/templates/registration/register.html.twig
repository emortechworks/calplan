{% extends 'base.html.twig' %}

{% block title %}
  Crear cuenta · Calendario Planeación
{% endblock %}

{% block body %}
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-5">
      <div class="card shadow-sm">
        <div class="card-body">
          <h1 class="h3 mb-4">Crea tu cuenta</h1>

          {{ form_errors(registrationForm) }}

          {{ form_start(registrationForm) }}
          {{ form_row(registrationForm.email, { label: 'Correo', attr: { class: 'form-control m-2' }, placeholder: 'correo@email.com' }) }}
          {{ form_row(registrationForm.plainPassword, { label: 'Contraseña', attr: { class: 'form-control m-2' } }) }}
          <div class="text-center">{{ form_row(registrationForm.agreeTerms, { label: 'Acepto los términos', attr: { class: 'form-check-input m-1' } }) }}</div>

          <button type="submit" class="btn btn-dark btn-lg w-100 mt-3">Crear cuenta</button>
          {{ form_end(registrationForm) }}
        </div>
      </div>
    </div>
  </div>
{% endblock %}
