{% extends 'base.html.twig' %}

{% block title %}
  Crear cuenta · Calendario Planeación
{% endblock %}

{% block body %}
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-5">
      <div class="card shadow-sm">
        <div class="card-body">
          <h1 class="h3 mb-4">Crea tu cuenta</h1>

          {{ form_errors(registrationForm) }}

          {{ form_start(registrationForm) }}
          <div class="mb-1">
            {{ form_row(registrationForm.email, { label: 'Correo', label_attr: { class: 'mb-1' }, attr: { class: 'form-control', placeholder: 'correo@email.com' } }) }}
          </div>
          <div class="mb-1">
            {{ form_row(registrationForm.plainPassword, { label: 'Contraseña', label_attr: { class: 'mb-1' }, attr: { class: 'form-control' } }) }}
          </div>
          <div class="mb-1">
            {{ form_row(registrationForm.agreeTerms, { label: 'Acepto los términos', label_attr: { class: 'mb-1' }, attr: { class: 'form-check-input m-1' } }) }}
          </div>
          <button type="submit" class="btn btn-dark btn-lg w-100 m-2 p-2">Crear cuenta</button>
          {{ form_end(registrationForm) }}
        </div>
      </div>
    </div>
  </div>
{% endblock %}
