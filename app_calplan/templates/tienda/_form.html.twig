{{ form_errors(form) }}
{{ form_start(form) }}
  <div class="mb-1">
    {{ form_row(form.nombre, { label_attr: { class: 'mb-1' }, attr: { class: 'form-control m-1' } }) }}
  </div>
  <div class="mb-1">
    {{ form_row(form.codigo, { label_attr: { class: 'mb-1' }, attr: { class: 'form-control m-1' } }) }}
  </div>
  <button type="submit" class="btn btn-dark m-2 p-2">Guardar</button>
  <a class="btn btn-outline-secondary m-2 p-2" href="{{ path('app_tienda_index') }}">Cancelar</a>
{{ form_end(form) }}
