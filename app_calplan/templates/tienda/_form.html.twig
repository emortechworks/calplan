{{ form_errors(form) }}
{{ form_start(form) }}
  <div class="mb-1">
    {{ form_row(form.nombre, { label_attr: { class: 'mb-1' }, attr: { class: 'form-control m-1' } }) }}
  </div>
  <div class="mb-1">
    {{ form_row(form.codigo, { label_attr: { class: 'mb-1' }, attr: { class: 'form-control m-1' } }) }}
  </div>

  <div class="mb-3 mt-2">
    <label class="form-label mb-1 fw-semibold d-flex align-items-center gap-1">
      {{ ux_icon('bi:person-badge') }}
      <span>Roles disponibles en esta tienda</span>
    </label>
    {{ form_errors(form.roles) }}
    {% if form.roles|length > 0 %}
      <div class="d-flex flex-wrap gap-2 mt-1">
        {% for child in form.roles %}
          {{ form_widget(child, { attr: { class: 'btn-check', autocomplete: 'off' } }) }}
          <label class="btn btn-outline-dark btn-sm d-inline-flex align-items-center gap-1" for="{{ child.vars.id }}">
            {{ ux_icon('bi:person-badge') }}
            <span>{{ child.vars.label }}</span>
          </label>
        {% endfor %}
      </div>
    {% else %}
      {% do form.roles.setRendered %}
      <p class="small text-body-secondary mb-0">
        Aún no tienes roles activos. <a href="{{ path('app_rol_nuevo') }}">Crea el primero</a> o guarda sin roles por ahora.
      </p>
    {% endif %}
  </div>

  <button type="submit" class="btn btn-dark m-2 p-2 d-inline-flex align-items-center gap-2">
    {{ ux_icon('bi:check-lg') }}
    <span>Guardar</span>
  </button>
  <a class="btn btn-outline-secondary m-2 p-2 d-inline-flex align-items-center gap-2" href="{{ path('app_tienda_index') }}">
    {{ ux_icon('bi:x-lg') }}
    <span>Cancelar</span>
  </a>
{{ form_end(form) }}
