{% extends 'base.html.twig' %}

{% block title %}Mis tiendas · Calendario Planeación{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0">Mis tiendas</h1>
  <a class="btn btn-dark" href="{{ path('app_tienda_nueva') }}">Nueva tienda</a>
</div>

{% for tienda in tiendas %}
  <div class="card mb-2 {{ not tienda.activa ? 'border-secondary opacity-75' }}">
    <div class="card-body d-flex justify-content-between align-items-center">
      <div>
        <span class="fw-bold">{{ tienda.nombre }}</span>
        {% if tienda.codigo %}<span class="badge text-bg-secondary ms-2">{{ tienda.codigo }}</span>{% endif %}
        {% if not tienda.activa %}<span class="badge text-bg-warning ms-2">desactivada</span>{% endif %}
      </div>
      <div class="btn-group btn-group-sm">
        <a class="btn btn-outline-secondary" href="{{ path('app_tienda_editar', { id: tienda.id }) }}">Editar</a>
        <form method="post" action="{{ path('app_tienda_alternar', { id: tienda.id }) }}" class="m-0">
          <input type="hidden" name="_token" value="{{ csrf_token('alternar' ~ tienda.id) }}">
          <button class="btn btn-outline-secondary" type="submit">{{ tienda.activa ? 'Desactivar' : 'Reactivar' }}</button>
        </form>
      </div>
    </div>
  </div>
{% else %}
  <p class="text-body-secondary">Aún no tienes tiendas. <a href="{{ path('app_tienda_nueva') }}">Crea la primera</a>.</p>
{% endfor %}
{% endblock %}
