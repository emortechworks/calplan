{{ form_errors(form) }}
{{ form_start(form, { attr: { 'data-controller': 'atributo-tipo' } }) }}
  <div class="row g-2">
    <div class="col-md-6 mb-1">
      {{ form_row(form.nombre, { label_attr: { class: 'mb-1' }, attr: { class: 'form-control m-1' } }) }}
    </div>
    <div class="col-md-4 mb-1">
      {{ form_row(form.tipo, {
        label_attr: { class: 'mb-1' },
        attr: {
          class: 'form-select m-1',
          'data-atributo-tipo-target': 'tipo',
          'data-action': 'change->atributo-tipo#cambiar',
        },
      }) }}
      {% if tipoBloqueado %}
        <div class="form-text ms-1">El tipo no puede cambiarse porque ya tiene valores capturados en personal.</div>
      {% endif %}
    </div>
    <div class="col-md-2 mb-1">
      {{ form_row(form.orden, { label_attr: { class: 'mb-1' }, attr: { class: 'form-control m-1' } }) }}
    </div>
  </div>

  <div class="mb-2 mt-1 {{ form.tipo.vars.value != 'lista' ? 'd-none' }}" data-atributo-tipo-target="opcionesWrapper">
    {{ form_row(form.opcionesTexto, { label_attr: { class: 'mb-1' }, attr: { class: 'form-control m-1' } }) }}
  </div>

  <button type="submit" class="btn btn-dark m-2 p-2 d-inline-flex align-items-center gap-2">
    {{ ux_icon('bi:check-lg') }}
    <span>Guardar</span>
  </button>
  <a class="btn btn-outline-secondary m-2 p-2 d-inline-flex align-items-center gap-2" href="{{ path('app_atributo_perfil_index') }}">
    {{ ux_icon('bi:x-lg') }}
    <span>Cancelar</span>
  </a>
{{ form_end(form) }}
