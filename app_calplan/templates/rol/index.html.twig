{% extends 'base.html.twig' %}

{% block title %}Roles · Calendario Planeación{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0 d-flex align-items-center gap-2">
    {{ ux_icon('bi:person-badge') }}
    <span>Roles</span>
  </h1>
  <a class="btn btn-dark m-2 p-2 d-inline-flex align-items-center gap-2" href="{{ path('app_rol_nuevo') }}">
    {{ ux_icon('bi:plus-lg') }}
    <span>Nuevo rol</span>
  </a>
</div>

{% for rol in roles %}
  <div class="card mb-2 {{ not rol.activo ? 'border-secondary opacity-75' }}">
    <div class="card-body d-flex justify-content-between align-items-center">
      <div class="d-flex align-items-center gap-2">
        {{ ux_icon('bi:person-badge', { class: 'text-body-secondary' }) }}
        <span class="fw-bold">{{ rol.nombre }}</span>
        {% if not rol.activo %}<span class="badge text-bg-warning">desactivado</span>{% endif %}
      </div>
      <div class="btn-group btn-group-sm">
        <a class="btn btn-outline-secondary m-2 p-2 d-inline-flex align-items-center gap-1" href="{{ path('app_rol_editar', { id: rol.id }) }}">
          {{ ux_icon('bi:pencil') }}
          <span>Editar</span>
        </a>
        <form method="post" action="{{ path('app_rol_alternar', { id: rol.id }) }}" class="m-0">
          <input type="hidden" name="_token" value="{{ csrf_token('alternar_rol' ~ rol.id) }}">
          <button class="btn btn-outline-secondary m-2 p-2 d-inline-flex align-items-center gap-1" type="submit">
            {% if rol.activo %}
              {{ ux_icon('bi:slash-circle') }}
              <span>Desactivar</span>
            {% else %}
              {{ ux_icon('bi:check-circle') }}
              <span>Reactivar</span>
            {% endif %}
          </button>
        </form>
      </div>
    </div>
  </div>
{% else %}
  <p class="text-body-secondary">Aún no tienes roles. <a href="{{ path('app_rol_nuevo') }}">Crea el primero</a>.</p>
{% endfor %}
{% endblock %}
