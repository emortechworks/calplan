<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>
      {% block title %}
        Calendario Planeación
      {% endblock %}
    </title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>" />
    {% block stylesheets %}

    {% endblock %}

    {% block javascripts %}
      {% block importmap %}
        {{ importmap('app') }}
      {% endblock %}
    {% endblock %}
  </head>
  {# Sticky footer: min-vh-100 + mt-auto mantienen el pie pegado abajo aunque no haya contenido. #}
  <body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-md navbar-dark bg-dark border-bottom">
      <div class="container">
        <a class="navbar-brand fw-bold" href="{{ path('app_home') }}">Calendario Planeación</a>
        <div class="d-flex align-items-center gap-2">
          {% if app.user %}
            <a class="nav-link text-white" href="{{ path('app_cuenta') }}">{{ app.user.userIdentifier }}</a>
            <form action="{{ path('app_logout') }}" method="post" class="m-0">
              <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}" />
              <button type="submit" class="btn btn-outline-light btn-sm">Cerrar sesión</button>
            </form>
          {% else %}
            <a class="btn btn-outline-light btn-sm" href="{{ path('app_login') }}">Entrar</a>
            <a class="btn btn-outline-light btn-sm" href="{{ path('app_register') }}">Registrarse</a>
          {% endif %}
        </div>
      </div>
    </nav>
    <main class="container my-4 flex-grow-1">
      {% block body %}

      {% endblock %}
    </main>
    <footer class="mt-auto py-3 border-top text-center text-body-secondary">
      <small>Planeación semanal de tienda</small>
    </footer>
  </body>
</html>
