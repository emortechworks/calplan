<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>
      {% block title %}
        Calendario Planeación
      {% endblock %}
    </title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>" />
    {% block stylesheets %}

    {% endblock %}

    {% block javascripts %}
      {% block importmap %}
        {{ importmap('app') }}
      {% endblock %}
    {% endblock %}
  </head>
  {# Sticky footer: min-vh-100 + mt-auto mantienen el pie pegado abajo aunque no haya contenido. #}
  <body class="d-flex flex-column min-vh-100" data-controller="carga">
    <div id="indicador-carga" data-carga-target="overlay" class="indicador-carga-overlay position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center d-none" aria-live="polite" aria-busy="true">
      <div class="d-flex flex-column align-items-center gap-2">
        <div class="spinner-border text-dark" role="status">
          <span class="visually-hidden">Cargando...</span>
        </div>
        <span class="small text-body-secondary">Cargando...</span>
      </div>
    </div>
    <nav class="navbar navbar-expand-md navbar-dark bg-dark border-bottom">
      <div class="container">
        <a class="navbar-brand fw-bold d-inline-flex align-items-center gap-2" href="{{ path('app_home') }}">
          {{ ux_icon('bi:calendar-week') }}
          <span>Calendario Planeación</span>
        </a>
        <div class="d-flex align-items-center gap-2">
          {% if app.user %}
            <a class="nav-link text-white d-inline-flex align-items-center gap-1" href="{{ path('app_sucursal_index') }}">
              {{ ux_icon('bi:shop') }}
              <span>Mis sucursales</span>
            </a>
            <a class="nav-link text-white d-inline-flex align-items-center gap-1" href="{{ path('app_rol_index') }}">
              {{ ux_icon('bi:person-badge') }}
              <span>Roles</span>
            </a>
            <a class="nav-link text-white d-inline-flex align-items-center gap-1" href="{{ path('app_personal_index') }}">
              {{ ux_icon('bi:people') }}
              <span>Personal</span>
            </a>
            <a class="nav-link text-white d-inline-flex align-items-center gap-1" href="{{ path('app_cuenta') }}">
              {{ ux_icon('bi:person-circle') }}
              <span>{{ app.user.userIdentifier }}</span>
            </a>
            <form action="{{ path('app_logout') }}" method="post" class="m-0">
              <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}" />
              <button type="submit" class="btn btn-outline-light btn-sm m-2 p-2 d-inline-flex align-items-center gap-1">
                {{ ux_icon('bi:box-arrow-right') }}
                <span>Cerrar sesión</span>
              </button>
            </form>
          {% else %}
            <a class="btn btn-outline-light btn-sm m-2 p-2 d-inline-flex align-items-center gap-1" href="{{ path('app_login') }}">
              {{ ux_icon('bi:box-arrow-in-right') }}
              <span>Entrar</span>
            </a>
            <a class="btn btn-outline-light btn-sm m-2 p-2 d-inline-flex align-items-center gap-1" href="{{ path('app_register') }}">
              {{ ux_icon('bi:person-plus') }}
              <span>Registrarse</span>
            </a>
          {% endif %}
        </div>
      </div>
    </nav>
    <main class="container my-4 flex-grow-1">
      {% for message in app.flashes('success') %}
        <div class="alert alert-success d-flex align-items-center gap-2">
          {{ ux_icon('bi:check-circle-fill') }}
          <span>{{ message }}</span>
        </div>
      {% endfor %}
      {% block body %}

      {% endblock %}
    </main>
    <footer class="mt-auto py-3 border-top text-center text-body-secondary">
      <small>Planeación semanal de sucursal</small>
    </footer>
  </body>
</html>
