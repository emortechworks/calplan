{{ form_errors(form) }}
{{ form_start(form) }}
  <div class="row g-2">
    <div class="col-md-8 mb-1">
      {{ form_row(form.nombre, { label_attr: { class: 'mb-1' }, attr: { class: 'form-control m-1' } }) }}
    </div>
    <div class="col-md-2 mb-1">
      {{ form_row(form.horasSemanales, { label_attr: { class: 'mb-1' }, attr: { class: 'form-control m-1' } }) }}
    </div>
    <div class="col-md-2 mb-1" data-controller="color-preview">
      {{ form_label(form.color, null, { label_attr: { class: 'form-label mb-1' } }) }}
      {{ form_widget(form.color, { attr: { class: 'd-none', 'data-color-preview-target': 'select' } }) }}
      <div class="dropdown m-1">
        <button
          type="button"
          class="form-select d-flex align-items-center"
          data-bs-toggle="dropdown"
          aria-expanded="false"
          aria-label="Seleccionar color identificador"
        >
          <span
            data-color-preview-target="muestra"
            class="d-inline-block rounded border border-secondary-subtle w-100 me-2"
            style="height: 1.25rem; background-color: {{ form.color.vars.value|default('#ffffff') }};"
          ></span>
        </button>
        <div class="dropdown-menu p-2 shadow-sm">
          <div class="color-dropdown-grid">
            {% for choice in form.color.vars.choices %}
              <button
                type="button"
                class="color-opcion-btn p-0"
                style="background-color: {{ choice.value }};"
                title="{{ choice.label }}"
                aria-label="{{ choice.label }}"
                data-color-preview-target="opcion"
                data-color-value="{{ choice.value }}"
                data-action="click->color-preview#elegir"
              ></button>
            {% endfor %}
          </div>
        </div>
      </div>
      {{ form_errors(form.color) }}
    </div>
  </div>

  <div class="row g-2">
    <div class="col-md-6 mb-1">
      {{ form_row(form.fechaNacimiento, { label_attr: { class: 'mb-1' }, attr: { class: 'form-control m-1' } }) }}
    </div>
    <div class="col-md-6 mb-1">
      {{ form_row(form.finContrato, { label_attr: { class: 'mb-1' }, attr: { class: 'form-control m-1' } }) }}
    </div>
  </div>

  <div data-controller="roles-ordenados">
    <div class="mb-3 mt-2">
      <label class="form-label mb-1 fw-semibold d-flex align-items-center gap-1">
        {{ ux_icon('bi:shop') }}
        <span>Sucursales asignadas</span>
      </label>
      {{ form_errors(form.sucursales) }}
      {% if form.sucursales|length > 0 %}
        <div class="d-flex flex-wrap gap-2 mt-1">
          {% for child in form.sucursales %}
            {{ form_widget(child, { attr: { class: 'btn-check', autocomplete: 'off', 'data-sucursal-checkbox': 'true', 'data-action': 'change->roles-ordenados#actualizarSucursales' } }) }}
            <label class="btn btn-outline-dark btn-sm d-inline-flex align-items-center gap-1" for="{{ child.vars.id }}">
              {{ ux_icon('bi:shop') }}
              <span>{{ child.vars.label }}</span>
            </label>
          {% endfor %}
        </div>
      {% else %}
        {% do form.sucursales.setRendered %}
        <p class="small text-body-secondary mb-0">
          Aún no tienes sucursales activas. <a href="{{ path('app_sucursal_nueva') }}">Crea una sucursal</a> o guarda sin sucursal por ahora.
        </p>
      {% endif %}
    </div>

    <div class="mb-3">
      <label class="form-label mb-1 fw-semibold d-flex align-items-center gap-1">
        {{ ux_icon('bi:person-badge') }}
        <span>Roles y prioridad por sucursal</span>
      </label>
      <p class="small text-body-secondary mb-2">
       Selecciona los roles en orden de prioridad.
      </p>
      {{ form_widget(form.rolesPorSucursal, { attr: { 'data-roles-ordenados-target': 'input' } }) }}
      {{ form_errors(form.rolesPorSucursal) }}

      <div data-roles-ordenados-target="sinSucursales" class="alert alert-light border small text-body-secondary mb-0">
        Selecciona al menos una sucursal.
      </div>

      <div class="d-flex flex-column gap-3 mt-2">
        {% for panel in panelesPorSucursal %}
          {% set sucursal = panel.sucursal %}
          <div class="card {{ not panel.visible ? 'd-none' }}" data-roles-ordenados-target="panel" data-sucursal-panel-id="{{ sucursal.id }}">
            <div class="card-header bg-body-tertiary d-flex align-items-center justify-content-between gap-2">
              <span class="fw-semibold d-inline-flex align-items-center gap-1">
                {{ ux_icon('bi:shop') }}
                <span>{{ sucursal.nombre }}</span>
                {% if not sucursal.activa %}<span class="badge text-bg-warning">desactivada</span>{% endif %}
              </span>
              <a class="small text-decoration-none" href="{{ path('app_sucursal_editar', { id: sucursal.id }) }}">Configurar roles de la sucursal</a>
            </div>
            <div class="card-body">
              {% if panel.rolesAsignados|length == 0 and panel.rolesDisponibles|length == 0 %}
                <p class="small text-body-secondary mb-0">
                  Esta sucursal todavía no tiene roles habilitados.
                  <a href="{{ path('app_sucursal_editar', { id: sucursal.id }) }}">Agrega roles a {{ sucursal.nombre }}</a>.
                </p>
              {% else %}
                <div class="border rounded p-2 mb-2 bg-body-tertiary">
                  <div class="small fw-semibold text-body-secondary mb-2">Roles asignados en {{ sucursal.nombre }} (de mayor a menor peso)</div>
                  <div data-lista-vacio class="small text-body-secondary {{ panel.rolesAsignados|length > 0 ? 'd-none' }}">
                    Sin roles asignados en esta sucursal. Agrega alguno desde la lista de abajo.
                  </div>
                  <div class="d-flex flex-column gap-2" data-lista-asignados>
                    {% for rol in panel.rolesAsignados %}
                      <div class="border rounded bg-white p-2 d-flex justify-content-between align-items-center gap-2" data-rol-id="{{ rol.id }}" data-rol-nombre="{{ rol.nombre }}">
                        <div>
                          <div class="d-flex align-items-center gap-2 flex-wrap">
                            <span class="badge {{ loop.first ? 'text-bg-dark' : 'text-bg-secondary' }}" data-role-badge>{{ loop.first ? '#1 Principal' : '#' ~ loop.index }}</span>
                            <span class="fw-semibold">{{ rol.nombre }}</span>
                            {% if not rol.activo %}<span class="badge text-bg-warning">desactivado</span>{% endif %}
                          </div>
                          {% if rol.descripcion %}
                            <div class="small text-body-secondary mt-1">{{ rol.descripcion }}</div>
                          {% endif %}
                        </div>
                        <div class="d-flex align-items-center gap-1" data-acciones-asignado>
                          <button type="button" class="btn btn-outline-secondary btn-sm p-1" title="Subir prioridad" data-btn-subir data-action="click->roles-ordenados#subir">
                            {{ ux_icon('bi:arrow-up') }}
                          </button>
                          <button type="button" class="btn btn-outline-secondary btn-sm p-1" title="Bajar prioridad" data-btn-bajar data-action="click->roles-ordenados#bajar">
                            {{ ux_icon('bi:arrow-down') }}
                          </button>
                          <button type="button" class="btn btn-outline-danger btn-sm p-1" title="Quitar rol" data-action="click->roles-ordenados#quitar">
                            {{ ux_icon('bi:x-lg') }}
                          </button>
                        </div>
                        <div class="d-none" data-acciones-disponible>
                          <button type="button" class="btn btn-outline-dark btn-sm d-inline-flex align-items-center gap-1" data-action="click->roles-ordenados#agregar">
                            {{ ux_icon('bi:plus-lg') }}
                            <span>Agregar</span>
                          </button>
                        </div>
                      </div>
                    {% endfor %}
                  </div>
                </div>

                <div class="border rounded p-2">
                  <div class="small fw-semibold text-body-secondary mb-2">Roles disponibles en {{ sucursal.nombre }}</div>
                  <div class="d-flex flex-column gap-2" data-lista-disponibles>
                    {% for rol in panel.rolesDisponibles %}
                      <div class="border rounded bg-white p-2 d-flex justify-content-between align-items-center gap-2" data-rol-id="{{ rol.id }}" data-rol-nombre="{{ rol.nombre }}">
                        <div>
                          <div class="d-flex align-items-center gap-2 flex-wrap">
                            <span class="badge text-bg-secondary d-none" data-role-badge></span>
                            <span class="fw-semibold">{{ rol.nombre }}</span>
                            {% if not rol.activo %}<span class="badge text-bg-warning">desactivado</span>{% endif %}
                          </div>
                          {% if rol.descripcion %}
                            <div class="small text-body-secondary mt-1">{{ rol.descripcion }}</div>
                          {% endif %}
                        </div>
                        <div class="d-none d-flex align-items-center gap-1" data-acciones-asignado>
                          <button type="button" class="btn btn-outline-secondary btn-sm p-1" title="Subir prioridad" data-btn-subir data-action="click->roles-ordenados#subir">
                            {{ ux_icon('bi:arrow-up') }}
                          </button>
                          <button type="button" class="btn btn-outline-secondary btn-sm p-1" title="Bajar prioridad" data-btn-bajar data-action="click->roles-ordenados#bajar">
                            {{ ux_icon('bi:arrow-down') }}
                          </button>
                          <button type="button" class="btn btn-outline-danger btn-sm p-1" title="Quitar rol" data-action="click->roles-ordenados#quitar">
                            {{ ux_icon('bi:x-lg') }}
                          </button>
                        </div>
                        <div data-acciones-disponible>
                          <button type="button" class="btn btn-outline-dark btn-sm d-inline-flex align-items-center gap-1" data-action="click->roles-ordenados#agregar">
                            {{ ux_icon('bi:plus-lg') }}
                            <span>Agregar</span>
                          </button>
                        </div>
                      </div>
                    {% endfor %}
                  </div>
                </div>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>

  <button type="submit" class="btn btn-dark m-2 p-2 d-inline-flex align-items-center gap-2">
    {{ ux_icon('bi:check-lg') }}
    <span>Guardar</span>
  </button>
  <a class="btn btn-outline-secondary m-2 p-2 d-inline-flex align-items-center gap-2" href="{{ path('app_personal_index') }}">
    {{ ux_icon('bi:x-lg') }}
    <span>Cancelar</span>
  </a>
{{ form_end(form) }}
