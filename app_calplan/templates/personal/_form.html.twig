{{ form_errors(form) }}
{{ form_start(form) }}
  <div class="row g-2">
    <div class="col-md-8 mb-1">
      {{ form_row(form.nombre, { label_attr: { class: 'mb-1' }, attr: { class: 'form-control m-1' } }) }}
    </div>
    <div class="col-md-4 mb-1">
      {{ form_row(form.horasSemanales, { label_attr: { class: 'mb-1' }, attr: { class: 'form-control m-1' } }) }}
    </div>
  </div>

  <div class="row g-2">
    <div class="col-md-6 mb-1">
      {{ form_row(form.fechaNacimiento, { label_attr: { class: 'mb-1' }, attr: { class: 'form-control m-1' } }) }}
    </div>
    <div class="col-md-6 mb-1">
      {{ form_row(form.finContrato, { label_attr: { class: 'mb-1' }, attr: { class: 'form-control m-1' } }) }}
    </div>
  </div>

  <div data-controller="roles-ordenados">
    <div class="mb-3 mt-2">
      <label class="form-label mb-1 fw-semibold d-flex align-items-center gap-1">
        {{ ux_icon('bi:shop') }}
        <span>Tiendas asignadas</span>
      </label>
      {{ form_errors(form.tiendas) }}
      {% if form.tiendas|length > 0 %}
        <div class="d-flex flex-wrap gap-2 mt-1">
          {% for child in form.tiendas %}
            {{ form_widget(child, { attr: { class: 'btn-check', autocomplete: 'off', 'data-tienda-checkbox': 'true', 'data-action': 'change->roles-ordenados#actualizarTiendas' } }) }}
            <label class="btn btn-outline-dark btn-sm d-inline-flex align-items-center gap-1" for="{{ child.vars.id }}">
              {{ ux_icon('bi:shop') }}
              <span>{{ child.vars.label }}</span>
            </label>
          {% endfor %}
        </div>
      {% else %}
        {% do form.tiendas.setRendered %}
        <p class="small text-body-secondary mb-0">
          Aún no tienes tiendas activas. <a href="{{ path('app_tienda_nueva') }}">Crea una tienda</a> o guarda sin tienda por ahora.
        </p>
      {% endif %}
    </div>

    <div class="mb-3">
      <label class="form-label mb-1 fw-semibold d-flex align-items-center gap-1">
        {{ ux_icon('bi:person-badge') }}
        <span>Roles y prioridad por tienda</span>
      </label>
      <p class="small text-body-secondary mb-2">
        Cada tienda seleccionada despliega únicamente sus roles disponibles. Dentro de cada tienda, <strong>#1</strong> tiene el mayor peso (principal), seguido de <strong>#2</strong>, <strong>#3</strong>…
      </p>
      {{ form_widget(form.rolesPorTienda, { attr: { 'data-roles-ordenados-target': 'input' } }) }}
      {{ form_errors(form.rolesPorTienda) }}

      <div data-roles-ordenados-target="sinTiendas" class="alert alert-light border small text-body-secondary mb-0">
        Selecciona al menos una tienda arriba para desplegar y priorizar sus roles.
      </div>

      <div class="d-flex flex-column gap-3 mt-2">
        {% for panel in panelesPorTienda %}
          {% set tienda = panel.tienda %}
          <div class="card {{ not panel.visible ? 'd-none' }}" data-roles-ordenados-target="panel" data-tienda-panel-id="{{ tienda.id }}">
            <div class="card-header bg-body-tertiary d-flex align-items-center justify-content-between gap-2">
              <span class="fw-semibold d-inline-flex align-items-center gap-1">
                {{ ux_icon('bi:shop') }}
                <span>{{ tienda.nombre }}</span>
                {% if not tienda.activa %}<span class="badge text-bg-warning">desactivada</span>{% endif %}
              </span>
              <a class="small text-decoration-none" href="{{ path('app_tienda_editar', { id: tienda.id }) }}">Configurar roles de la tienda</a>
            </div>
            <div class="card-body">
              {% if panel.rolesAsignados|length == 0 and panel.rolesDisponibles|length == 0 %}
                <p class="small text-body-secondary mb-0">
                  Esta tienda todavía no tiene roles habilitados.
                  <a href="{{ path('app_tienda_editar', { id: tienda.id }) }}">Agrega roles a {{ tienda.nombre }}</a>.
                </p>
              {% else %}
                <div class="border rounded p-2 mb-2 bg-body-tertiary">
                  <div class="small fw-semibold text-body-secondary mb-2">Roles asignados en {{ tienda.nombre }} (de mayor a menor peso)</div>
                  <div data-lista-vacio class="small text-body-secondary {{ panel.rolesAsignados|length > 0 ? 'd-none' }}">
                    Sin roles asignados en esta tienda. Agrega alguno desde la lista de abajo.
                  </div>
                  <div class="d-flex flex-column gap-2" data-lista-asignados>
                    {% for rol in panel.rolesAsignados %}
                      <div class="border rounded bg-white p-2 d-flex justify-content-between align-items-center gap-2" data-rol-id="{{ rol.id }}" data-rol-nombre="{{ rol.nombre }}">
                        <div>
                          <div class="d-flex align-items-center gap-2 flex-wrap">
                            <span class="badge {{ loop.first ? 'text-bg-dark' : 'text-bg-secondary' }}" data-role-badge>{{ loop.first ? '#1 Principal' : '#' ~ loop.index }}</span>
                            <span class="fw-semibold">{{ rol.nombre }}</span>
                            {% if not rol.activo %}<span class="badge text-bg-warning">desactivado</span>{% endif %}
                          </div>
                          {% if rol.descripcion %}
                            <div class="small text-body-secondary mt-1">{{ rol.descripcion }}</div>
                          {% endif %}
                        </div>
                        <div class="d-flex align-items-center gap-1" data-acciones-asignado>
                          <button type="button" class="btn btn-outline-secondary btn-sm p-1" title="Subir prioridad" data-btn-subir data-action="click->roles-ordenados#subir">
                            {{ ux_icon('bi:arrow-up') }}
                          </button>
                          <button type="button" class="btn btn-outline-secondary btn-sm p-1" title="Bajar prioridad" data-btn-bajar data-action="click->roles-ordenados#bajar">
                            {{ ux_icon('bi:arrow-down') }}
                          </button>
                          <button type="button" class="btn btn-outline-danger btn-sm p-1" title="Quitar rol" data-action="click->roles-ordenados#quitar">
                            {{ ux_icon('bi:x-lg') }}
                          </button>
                        </div>
                        <div class="d-none" data-acciones-disponible>
                          <button type="button" class="btn btn-outline-dark btn-sm d-inline-flex align-items-center gap-1" data-action="click->roles-ordenados#agregar">
                            {{ ux_icon('bi:plus-lg') }}
                            <span>Agregar</span>
                          </button>
                        </div>
                      </div>
                    {% endfor %}
                  </div>
                </div>

                <div class="border rounded p-2">
                  <div class="small fw-semibold text-body-secondary mb-2">Roles disponibles en {{ tienda.nombre }}</div>
                  <div class="d-flex flex-column gap-2" data-lista-disponibles>
                    {% for rol in panel.rolesDisponibles %}
                      <div class="border rounded bg-white p-2 d-flex justify-content-between align-items-center gap-2" data-rol-id="{{ rol.id }}" data-rol-nombre="{{ rol.nombre }}">
                        <div>
                          <div class="d-flex align-items-center gap-2 flex-wrap">
                            <span class="badge text-bg-secondary d-none" data-role-badge></span>
                            <span class="fw-semibold">{{ rol.nombre }}</span>
                            {% if not rol.activo %}<span class="badge text-bg-warning">desactivado</span>{% endif %}
                          </div>
                          {% if rol.descripcion %}
                            <div class="small text-body-secondary mt-1">{{ rol.descripcion }}</div>
                          {% endif %}
                        </div>
                        <div class="d-none d-flex align-items-center gap-1" data-acciones-asignado>
                          <button type="button" class="btn btn-outline-secondary btn-sm p-1" title="Subir prioridad" data-btn-subir data-action="click->roles-ordenados#subir">
                            {{ ux_icon('bi:arrow-up') }}
                          </button>
                          <button type="button" class="btn btn-outline-secondary btn-sm p-1" title="Bajar prioridad" data-btn-bajar data-action="click->roles-ordenados#bajar">
                            {{ ux_icon('bi:arrow-down') }}
                          </button>
                          <button type="button" class="btn btn-outline-danger btn-sm p-1" title="Quitar rol" data-action="click->roles-ordenados#quitar">
                            {{ ux_icon('bi:x-lg') }}
                          </button>
                        </div>
                        <div data-acciones-disponible>
                          <button type="button" class="btn btn-outline-dark btn-sm d-inline-flex align-items-center gap-1" data-action="click->roles-ordenados#agregar">
                            {{ ux_icon('bi:plus-lg') }}
                            <span>Agregar</span>
                          </button>
                        </div>
                      </div>
                    {% endfor %}
                  </div>
                </div>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>

  <button type="submit" class="btn btn-dark m-2 p-2 d-inline-flex align-items-center gap-2">
    {{ ux_icon('bi:check-lg') }}
    <span>Guardar</span>
  </button>
  <a class="btn btn-outline-secondary m-2 p-2 d-inline-flex align-items-center gap-2" href="{{ path('app_personal_index') }}">
    {{ ux_icon('bi:x-lg') }}
    <span>Cancelar</span>
  </a>
{{ form_end(form) }}
