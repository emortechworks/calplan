{% extends 'base.html.twig' %}

{% block title %}
  Mi cuenta · Calendario Planeación
{% endblock %}

{% block body %}
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
      <div class="card shadow-sm">
        <div class="card-body text-center py-5">
          {{ ux_icon('bi:person-circle', { class: 'text-body-secondary mb-3', width: '3rem', height: '3rem' }) }}
          <h1 class="display-6 fw-semibold mb-3">Mi cuenta</h1>
          <p class="lead mb-4">Has iniciado sesión como:</p>
          <p class="fs-5 fw-bold">{{ app.user.userIdentifier }}</p>
          <a class="btn btn-dark m-2 p-2 d-inline-flex align-items-center gap-2" href="{{ path('app_home') }}">
            {{ ux_icon('bi:house') }}
            <span>Inicio</span>
          </a>
        </div>
      </div>
    </div>
  </div>
{% endblock %}
